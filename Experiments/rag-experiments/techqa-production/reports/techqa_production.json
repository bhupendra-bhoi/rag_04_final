{
  "title": "RAG Multi-Config Evaluation Report",
  "strategy_name": "detailed_query",
  "sections": [
    {
      "config_name": "techqa_production",
      "config_summary": {
        "name": "techqa_production",
        "mode": "test",
        "providers": {
          "openrouter": {
            "type": "openrouter",
            "api_key_env": "OPENROUTER_API_KEY",
            "params": {
              "cooldown_seconds": 60
